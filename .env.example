# ══════════════════════════════════════════════════════════════
# Jangkar Coffee Industry — contoh environment
#
# Salin ke .env.local (Next.js) atau .env (Express), lalu isi.
# JANGAN pernah menaruh nilai asli di file ini — file ini masuk git.
# ══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# project ref: fylxkwqwuaidbfpmdwhu
NEXT_PUBLIC_SUPABASE_URL=
# key publishable — aman untuk browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# key rahasia (sb_secret_...) — HANYA server. Tidak pernah di apps/web
# atau apps/admin dengan prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# koneksi Postgres langsung, kalau diperlukan
DATABASE_URL=

# ── apps/api ──────────────────────────────────────────────────
API_PORT=4000
# origin yang boleh memanggil API, dipisah koma
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── apps/web & apps/admin ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
