# ══════════════════════════════════════════════════════════════
# Jangkar Coffee Industry, contoh environment
#
# Salin ke .env.local (Next.js) atau .env (Express), lalu isi.
# JANGAN pernah menaruh nilai asli di berkas ini, berkas ini masuk git.
# ══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# project ref: fylxkwqwuaidbfpmdwhu
NEXT_PUBLIC_SUPABASE_URL=
# key publishable, aman untuk browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dipakai apps/api. Nilainya sama dengan NEXT_PUBLIC_SUPABASE_URL, dipisah
# karena API tidak seharusnya membaca variabel berprefiks NEXT_PUBLIC_.
SUPABASE_URL=
# key rahasia (sb_secret_...), HANYA server. Tidak pernah di apps/web
# atau apps/admin dengan prefiks NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# koneksi Postgres langsung, kalau diperlukan
DATABASE_URL=

# ── apps/api ──────────────────────────────────────────────────
API_PORT=4000
# Origin yang boleh memanggil API dari peramban, dipisah koma.
#
# Sejak API diproksikan lewat origin situs, peramban TIDAK PERNAH memanggil API
# lintas origin, jadi daftar ini praktis tidak terpakai lagi. Ia dipertahankan
# sebagai pagar kalau suatu saat ada klien yang memanggil API langsung.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Garam untuk hash IP pada pesan form kontak. Boleh kosong, tapi mengisinya
# membuat hash tidak bisa dibalik dengan kamus alamat IP.
CONTACT_IP_SALT=

# Domain cookie sesi. BIARKAN KOSONG, termasuk di produksi.
#
# Cookie dipasang lewat proksi Next, jadi peramban melihatnya datang dari origin
# situs dan menyimpannya untuk domain itu tanpa perlu diberi tahu. Mengisi ini
# justru berbahaya: cookie sesi admin akan ikut terkirim ke SETIAP subdomain,
# termasuk yang tidak ada hubungannya dengan panel.
COOKIE_DOMAIN=
# Bucket Supabase Storage untuk media panel.
SUPABASE_MEDIA_BUCKET=public-media

# ── akun admin pertama ────────────────────────────────────────
# Dipakai SEKALI oleh: npm run bootstrap:admin -w apps/api
# Isi, jalankan skripnya, lalu HAPUS kembali kata sandinya dari berkas ini.
# Minimal 12 karakter, skripnya menolak yang lebih pendek.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# ── apps/web ──────────────────────────────────────────────────
# Alamat apps/api, dipakai DUA hal di sisi server dan TIDAK PERNAH oleh peramban:
#   1. rewrite /api/:path* di apps/web/next.config.ts
#   2. pengambilan data saat build oleh seksi Roastery dan Keliling
#
# Sengaja TANPA prefiks NEXT_PUBLIC_. Peramban selalu memanggil `/api` pada
# origin situs sendiri, jadi ia tidak perlu tahu alamat API sama sekali. Itu yang
# membuat cookie sesi selalu first-party dan menghapus CORS. Lihat next.config.ts.
#
# Lokal   : http://localhost:4000
# Produksi: URL deployment apps/api, misalnya https://jangkar-api.vercel.app
API_ORIGIN=http://localhost:4000

# Dipakai metadataBase untuk Open Graph. Isi dengan domain publik di produksi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
