# secrets/ memuat kredensial dan tidak boleh ter-commit, selamanya.
# jangkar-coffee-reference/ adalah aset sumber mentah (~9MB).
prototypes/
secrets/
jangkar-coffee-reference/

# ── backup situs ───────────────────────────────────────────────
# Aturan tetap proyek: backup sebelum setiap perubahan, ke subfolder
# bertanda waktu. Jangan pernah dilacak git, riwayat akan membengkak.
backups/

